# Copy this file to terraform.tfvars (which is gitignored) and fill in real values.
# In CI, these values come from GitHub secrets via TF_VAR_<name> env vars.

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"
recipient_email = "you@example.com"

